# Copy to .env and fill in. The .env file is never committed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Models in LiteLLM form: <provider>/<model name>
MODEL=anthropic/claude-haiku-5-5
MODEL_LOCAL=ollama_chat/gemma3:4b
MODEL_OPENROUTER_FREE=openrouter/openrouter/free

# Models for the /compare endpoint, comma separated
COMPARE_MODELS=anthropic/claude-haiku-5-5,ollama_chat/llama3.2:1b

# False downloads the latest LiteLLM price map on every start, so new models are priced.
# Set to True only if startup is slow without an internet connection.
LITELLM_LOCAL_MODEL_COST_MAP=False
