# Αντιγράψτε σε .env και συμπληρώστε. Το .env ΔΕΝ ανεβαίνει ποτέ στο git.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Μοντέλα σε μορφή LiteLLM: <provider>/<όνομα μοντέλου>
MODEL=anthropic/claude-haiku-5-5
MODEL_LOCAL=ollama_chat/gemma3:4b
MODEL_OPENROUTER_FREE=openrouter/openrouter/free

# Μοντέλα για το endpoint /compare, χωρισμένα με κόμμα
COMPARE_MODELS=anthropic/claude-haiku-5-5,ollama_chat/llama3.2:1b

LITELLM_LOCAL_MODEL_COST_MAP=False
